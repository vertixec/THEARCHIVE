NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SKOOL_URL=

# Generation providers. At least one key is required; models whose provider has
# no key are hidden from the panel and the MCP tool list. See KIE_SETUP.md.
FAL_KEY=
# KIE AI (https://kie.ai/api-key) — cheaper route to the same models.
KIE_API_KEY=

BILLING_ENABLED=true
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Leave unset for the first manual Skool launch.
# COMMUNITY_WEBHOOK_SECRET=

# Async generation finalization (webhook + sweeper).
# NEXT_PUBLIC_SITE_URL (https) is required for the provider webhook callbacks.
# FAL_WEBHOOK_SECRET / KIE_WEBHOOK_SECRET: optional tokens appended to each
#   provider's callback URL and verified on the way back in.
# CRON_SECRET: required by /api/cron/finalize-generations (Vercel Cron sends
#   it automatically as `Authorization: Bearer <CRON_SECRET>` when set).
# FAL_WEBHOOK_SECRET=
# KIE_WEBHOOK_SECRET=
# CRON_SECRET=
