NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FAL_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SKOOL_URL=

BILLING_ENABLED=true
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Leave unset for the first manual Skool launch.
# COMMUNITY_WEBHOOK_SECRET=

# Async generation finalization (webhook + sweeper).
# NEXT_PUBLIC_SITE_URL (https) is required for the FAL webhook callback.
# FAL_WEBHOOK_SECRET: optional token appended to the callback URL.
# CRON_SECRET: required by /api/cron/finalize-generations (Vercel Cron sends
#   it automatically as `Authorization: Bearer <CRON_SECRET>` when set).
# FAL_WEBHOOK_SECRET=
# CRON_SECRET=
